APP_NAME=Game Event API
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST/DATABASE?sslmode=require
# Discord OAuth credentials are optional. Register both callback URLs in the Discord application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/api/auth/discord/callback
DISCORD_LOGIN_REDIRECT_URI=http://127.0.0.1:8000/api/auth/discord/login/callback
DISCORD_FRONTEND_REDIRECT_URI=http://127.0.0.1:5173/index.html
